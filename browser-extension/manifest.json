{
  "manifest_version": 3,
  "name": "Foundry Form Copilot",
  "version": "1.1.0",
  "description": "既存の業務 Web システムに無改修でアドオンし、Microsoft Foundry Agent (File Search) の社内規程・マニュアルに基づいて画面操作・起票を支援するブラウザ拡張機能",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3001/*",
    "http://127.0.0.1:3002/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:3001/*",
    "http://localhost:3002/*",
    "http://localhost:8765/*",
    "https://*.azurewebsites.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Foundry Form Copilot サイドパネルを開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
