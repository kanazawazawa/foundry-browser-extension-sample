# Microsoft Foundry プロジェクト エンドポイント
# 例: https://<account>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=

# 使用するモデル デプロイ名
MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# 単一テナント指定が必要な場合のみ設定（空なら現在の az login 既定テナント）
AZURE_TENANT_ID=

# Work IQ MCP の Foundry 接続名（空なら File Search のみでエージェントを作成）
WORKIQ_CONNECTION_NAME=

# ローカル起動時のポート番号
BRIDGE_PORT=8765

# 合言葉モードを使う場合のアクセスキー（空なら認証なし。外部公開時は必ず設定）
DEMO_ACCESS_KEY=

# Entra ID Easy Auth + OBO 連携を使う場合のクライアント ID
ENTRA_CLIENT_ID=

# 許可する CORS オリジン（カンマ区切り。未設定時は localhost と chrome-extension:// のみ許可）
ALLOWED_ORIGINS=
